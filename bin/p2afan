#!/bin/sh
# Run from an extracted release, a checkout, or the installed source tree.
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -d "$base/p2afan" ]; then
    base=/opt/p2afan
fi
# Do not inherit an arbitrary module search path into a root hardware tool.
PYTHONPATH=$base
export PYTHONPATH
exec python3 -u -m p2afan.cli "$@"
